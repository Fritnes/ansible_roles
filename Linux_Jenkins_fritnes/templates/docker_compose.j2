version: '{{version}}'
services:
  {{jenkins_container_name}}:
    image: {{jenkins_image}}
    build: .
    environment:
      TZ: "Europe/Kiev"
    ports:
      - 8081:8080
      - 50000:50000
    container_name: {{jenkins_container_name}}
    volumes:
      - ./jenkins_home:/var/jenkins_home
{% if jenkins_docker_socket_enabled | bool %}
      - /var/run/docker.sock:/var/run/docker.sock
      - /usr/local/bin/docker:/usr/local/bin/docker
    group_add:
      - "{{ jenkins_docker_gid }}"
{% endif %}
