version: '{{version}}'
services:
  {{wggui_container_name}}:
    image: {{wgui_image}}
    container_name: {{wggui_container_name}}
    cap_add:
      - NET_ADMIN
    network_mode: host
    environment:
      - WGUI_USERNAME={{ wgui_username }}
      - WGUI_PASSWORD={{ wgui_password }}
    logging:
      driver: json-file
      options:
        max-size: 50m
    volumes:
      - ./db:/app/db
      - /etc/wireguard:/etc/wireguard
